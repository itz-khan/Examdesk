# Copy to `.env` in this directory (gitignored). Used by docker compose.
# Do NOT put real production secrets here or commit `.env`.

# ── Shared Postgres ────────────────────────────────────────────
POSTGRES_DB=examdesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only

# ── Shared app secrets (same on every backend instance) ────────
SECRET_KEY=change-this-to-a-long-random-secret-key-32chars
CERT_SECRET_KEY=change-this-cert-secret-local-only

# ── App ────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
